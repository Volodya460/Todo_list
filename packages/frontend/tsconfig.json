{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"lib": [
			"ES2020",
			"DOM",
			"DOM.Iterable"
		],
		"module": "ESNext",
		"skipLibCheck": true,
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"~/*": [
				"src/*"
			],
			"~typings/*": [
				"src/typings/*"
			],
			"~api/*": [
				"src/api/*"
			],
			"~assets/*": [
				"src/assets/*"
			],
			"~formSchemas/*": [
				"src/formSchemas/*"
			],
			"~helpers/*": [
				"src/helpers/*"
			],
			"~modules/*": [
				"src/modules/*"
			],
			"~pages/*": [
				"src/pages/*"
			],
			"~router/*": [
				"src/router/*"
			],
			"~shared/*": [
				"src/shared/*"
			],
			"~store/*": [
				"src/store/*"
			]
		}
	},
	"include": [
		"src",
		"vite.env.d.ts"
	],
	"references": [
		{
			"path": "./tsconfig.node.json"
		},
		{
			"path": "./tsconfig-checks.json"
		}
	]
}